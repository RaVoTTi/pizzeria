<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_thermal_print.PaymentScreenButtons" t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('js_invoice')]" position="after">
            <button class="button btn btn-info btn-lg d-flex justify-content-between align-items-baseline w-100 w-md-50 lh-lg"
                    t-on-click="() => this.printKitchenTicket()">
                <span><i class="fa fa-print me-2"/>Imprimir Ticket</span>
            </button>
        </xpath>
    </t>
</templates>
