<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="TakeAwayReceipt" t-inherit="point_of_sale.ReceiptHeader"
       t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('cashier')]" position="before">
            <t t-if='order.is_takeaway'>
                <div>--------------------------------</div>
                <div>
                    <span style="font-weight:bold;font-size: 13px;">
                        Take Away
                    </span>
                </div>
                <t t-if='order.config.pos_token'>
                    <div>--------------------------------</div>
                    <div>
                        <span style="font-weight:bold;font-size: 13px;">
                            Token Number : <t t-esc="order.config.pos_token"/>
                        </span>
                    </div>
                </t>
            </t>
            <t t-if="order.is_dine_in">
                <div>--------------------------------</div>
                <div>
                    <span style="font-weight:bold;font-size: 13px;">
                        Dine-In
                    </span>
                </div>
            </t>
        </xpath>
    </t>
</templates>
