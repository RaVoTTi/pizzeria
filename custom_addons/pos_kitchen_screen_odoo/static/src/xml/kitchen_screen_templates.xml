<?xml version="1.0" encoding="utf-8" ?>
<template>
    <t t-name="KitchenCustomDashBoard">
        <div id="kitchen_screen" class="kitchen">
            <div class="body_wrapper">
                <div class="kds-tabs">
                    <button class="kds-tab"
                            t-att-class="state.stages === 'draft' ? 'kds-tab kds-tab--active' : 'kds-tab'"
                            t-att-data-state="'draft'"
                            t-on-click="() => this.draftStage()">
                        Pendiente
                        <span class="kds-count-badge"><t t-esc="state.draft_count"/></span>
                    </button>
                    <button class="kds-tab"
                            t-att-class="state.stages === 'waiting' ? 'kds-tab kds-tab--active' : 'kds-tab'"
                            t-att-data-state="'waiting'"
                            t-on-click="() => this.waitingStage()">
                        En Horno
                        <span class="kds-count-badge"><t t-esc="state.waiting_count"/></span>
                    </button>
                    <button class="kds-tab"
                            t-att-class="state.stages === 'ready' ? 'kds-tab kds-tab--active' : 'kds-tab'"
                            t-att-data-state="'ready'"
                            t-on-click="() => this.readyStage()">
                        Listo
                        <span class="kds-count-badge"><t t-esc="state.ready_count"/></span>
                    </button>
                    <button class="kds-tab"
                            t-att-class="state.stages === 'delivered' ? 'kds-tab kds-tab--active' : 'kds-tab'"
                            t-att-data-state="'delivered'"
                            t-on-click="() => this.deliveredStage()">
                        Entregado
                        <span class="kds-count-badge"><t t-esc="state.delivered_count"/></span>
                    </button>
                </div>
                <div class="kds-grid">
                    <t t-call="KitchenOrder"/>
                </div>
            </div>
        </div>
    </t>

    <t t-name="KitchenOrder">
        <t t-foreach="state.order_details" t-as="order" t-key="order.id">
            <t t-if="state.shop_id == order.config_id[0]">
                <t t-if="order.order_status == state.stages">
                    <t t-set="elapsedColor" t-value="this.getElapsedColor(order)"/>
                    <t t-set="elapsedMins" t-value="this.getElapsedMinutes(order)"/>
                    <t t-set="orderType" t-value="this.getOrderType(order)"/>
                    <t t-set="customerName" t-value="this.getCustomerName(order)"/>

                    <div class="kds-card"
                         t-att-data-state="order.order_status"
                         t-on-click="(e) => this.onCardClick(e, order)">

                        <div class="kds-card-header">
                            <div class="order-info">
                                <t t-if="orderType === 'mesa'">
                                    <span class="kds-badge-mesa">MESA <t t-esc="order.table_id[1]"/></span>
                                </t>
                                <t t-else="">
                                    <span class="kds-badge-delivery">DELIVERY</span>
                                </t>
                                <span class="order-name">
                                    <t t-esc="order.pos_reference || order.name"/>
                                </span>
                                <t t-if="customerName">
                                    <span class="order-customer">
                                        <t t-esc="customerName"/>
                                    </span>
                                </t>
                            </div>
                            <div class="kds-elapsed"
                                 t-att-class="elapsedColor === 'red' ? 'kds-elapsed kds-elapsed--red' : elapsedColor === 'amber' ? 'kds-elapsed kds-elapsed--amber' : 'kds-elapsed kds-elapsed--green'">
                                <span class="kds-elapsed-num"><t t-esc="elapsedMins"/></span>
                                <span class="kds-elapsed-unit">min</span>
                            </div>
                        </div>

                        <div class="kds-card-body">
                            <t t-foreach="order.lines" t-as="lineId" t-key="lineId">
                                <t t-foreach="state.lines" t-as="line" t-key="line.id">
                                    <t t-if="lineId == line.id">
                                        <div class="kds-line"
                                             t-att-class="state.stages === 'waiting' and line.order_status === 'ready' ? 'kds-line kds-line--ready' : 'kds-line'">
                                            <span class="qty"><t t-esc="line.qty"/>x</span>
                                            <span class="product-name"><t t-esc="line.full_product_name"/></span>
                                            <t t-if="state.stages === 'waiting' and line.order_status !== 'ready'">
                                                <button class="kds-line-btn"
                                                        t-att-value="line.id"
                                                        t-on-click.stop="(e) => this.toggleOrderLine(e)">
                                                    Listo
                                                </button>
                                            </t>
                                        </div>
                                        <t t-if="line.note">
                                            <div class="kds-note">
                                                <t t-esc="line.note"/>
                                            </div>
                                        </t>
                                    </t>
                                </t>
                            </t>

                            <t t-if="order.order_status !== 'delivered'">
                                <div class="kds-next-action">
                                    <t t-if="order.order_status === 'draft'">TAP — AL HORNO</t>
                                    <t t-elif="order.order_status === 'waiting'">TAP — LISTO</t>
                                    <t t-elif="order.order_status === 'ready'">TAP — ENTREGADO</t>
                                </div>
                            </t>
                        </div>

                        <div class="kds-card-footer">
                            <button class="kds-btn-cancel"
                                    t-att-value="order.id"
                                    t-on-click.stop="(e) => this.cancelOrder(e)">
                                Cancelar
                            </button>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </t>
</template>