<?xml version="1.0" encoding="utf-8" ?>
<template>
    <t t-name="KitchenCustomDashBoard">
        <div id="kitchen_screen" class="kitchen">
            <div class="body_wrapper">

                <!-- ========== GLOBAL PREP HEADER ========== -->
                <div class="kds-prep-header"
                     t-att-class="state.prepExpanded ? 'kds-prep-header kds-prep-header--expanded' : 'kds-prep-header'">
                    <div class="kds-prep-header__title">Resumen de Preparacion</div>
                    <div class="kds-prep-header__summary">
                        <t t-foreach="state.prepSummary" t-as="item" t-key="item.product_id">
                            <div class="kds-prep-item"
                                 t-att-class="item.isUrgent ? 'kds-prep-item kds-prep-item--urgent' : 'kds-prep-item'">
                                <span class="kds-prep-item__qty"><t t-esc="item.qty"/>x</span>
                                <span class="kds-prep-item__name"><t t-esc="item.name"/></span>
                            </div>
                        </t>
                    </div>
                    <button class="kds-prep-header__toggle"
                            t-on-click="() => this.togglePrepHeader()">
                        <t t-if="state.prepExpanded">Ocultar</t>
                        <t t-else="">Expandir</t>
                    </button>
                </div>

                <!-- ========== STATION TABS ========== -->
                <div class="kds-station-tabs" t-if="state.stations.length > 1">
                    <button class="kds-station-tab"
                            t-att-class="state.activeStation === 'all' ? 'kds-station-tab kds-station-tab--active' : 'kds-station-tab'"
                            t-on-click="() => this.setStation('all')">
                        Todas
                    </button>
                    <t t-foreach="state.stations" t-as="station" t-key="station.id">
                        <button class="kds-station-tab"
                                t-att-class="state.activeStation === station.id ? 'kds-station-tab kds-station-tab--active' : 'kds-station-tab'"
                                t-on-click="() => this.setStation(station.id)">
                            <t t-esc="station.name"/>
                        </button>
                    </t>
                </div>

                <!-- ========== OVEN QUEUE INDICATOR ========== -->
                <div class="kds-oven-queue" t-if="state.showOvenQueue">
                    <div class="kds-oven-queue__icon"
                         t-att-class="state.ovenAvailable > 0 ? 'kds-oven-queue__icon kds-oven-queue__icon--available' : 'kds-oven-queue__icon'">
                        <t t-esc="state.ovenAvailable"/>
                    </div>
                    <span class="kds-oven-queue__text">
                        Espacio en horno: <span class="kds-oven-queue__count"><t t-esc="state.ovenAvailable"/>/<t t-esc="state.ovenCapacity"/></span>
                        — <span class="kds-oven-queue__count"><t t-esc="state.ovenWaiting"/></span> esperando
                    </span>
                </div>

                <!-- ========== STATE TABS ========== -->
                <div class="kds-tabs">
                    <button class="kds-tab"
                            t-att-class="state.stages === 'pending' ? 'kds-tab kds-tab--active' : 'kds-tab'"
                            t-att-data-state="'pending'"
                            t-on-click="() => this.pendingStage()">
                        Pendiente
                        <span class="kds-count-badge"><t t-esc="state.pending_count"/></span>
                    </button>
                    <button class="kds-tab"
                            t-att-class="state.stages === 'cooking' ? 'kds-tab kds-tab--active' : 'kds-tab'"
                            t-att-data-state="'cooking'"
                            t-on-click="() => this.cookingStage()">
                        En Horno
                        <span class="kds-count-badge"><t t-esc="state.cooking_count"/></span>
                    </button>
                    <button class="kds-tab"
                            t-att-class="state.stages === 'ready' ? 'kds-tab kds-tab--active' : 'kds-tab'"
                            t-att-data-state="'ready'"
                            t-on-click="() => this.readyStage()">
                        Listo
                        <span class="kds-count-badge"><t t-esc="state.ready_count"/></span>
                    </button>
                    <button class="kds-tab"
                            t-att-class="state.stages === 'delivered' ? 'kds-tab kds-tab--active' : 'kds-tab'"
                            t-att-data-state="'delivered'"
                            t-on-click="() => this.deliveredStage()">
                        Entregado
                        <span class="kds-count-badge"><t t-esc="state.delivered_count"/></span>
                    </button>
                </div>

                <!-- ========== TICKET GRID ========== -->
                <div class="kds-grid">
                    <t t-foreach="state.sortedTickets" t-as="ticket" t-key="ticket.id">
                        <t t-if="ticket.state == state.stages">
                            <t t-set="elapsedColor" t-value="this.getElapsedColor(ticket)"/>
                            <t t-set="elapsedMins" t-value="this.getElapsedMinutes(ticket)"/>
                            <t t-set="ticketType" t-value="this.getTicketType(ticket)"/>
                            <t t-set="partner" t-value="this.getPartnerName(ticket)"/>

                            <div class="kds-card"
                                 t-att-class="this.getCardClasses(ticket)"
                                 t-att-data-state="ticket.state"
                                 t-att-data-ticket-id="ticket.id"
                                 t-on-click="(e) => this.onCardClick(e, ticket)">

                                <!-- Sync Error Indicator -->
                                <div class="kds-sync-error" t-if="ticket.syncError" title="Error de sincronizacion">!</div>

                                <div class="kds-card-header">
                                    <!-- Line 1: ID • Client/Table • Time -->
                                    <div class="kds-header-row-1">
                                        <div class="kds-header-identity">
                                            <span class="kds-order-id">#<t t-esc="(ticket.sequence || 'KT-0001').replace('KT-', '')"/><t t-esc="ticket.batch_letter || 'A'"/></span>
                                            <span class="kds-header-dot">•</span>
                                            <t t-if="ticket.order_type === 'mesa'">
                                                <span class="kds-customer-name">MESA <t t-esc="ticket.table_name"/></span>
                                            </t>
                                            <t t-elif="partner">
                                                <span class="kds-customer-name"><t t-esc="partner"/></span>
                                            </t>
                                            <t t-else="">
                                                <span class="kds-customer-name">RETIRO</span>
                                            </t>
                                        </div>
                                        <t t-set="timeDisp" t-value="this.formatTimeDisplay(ticket)"/>
                                        <span t-att-class="'kds-time-badge kds-time--' + elapsedColor + (timeDisp.hasRequested ? ' kds-time--requested' : '')">
                                            <t t-esc="timeDisp.text"/>
                                        </span>
                                    </div>

                                    <!-- Line 2: Ticket Type • Order Type • Payment -->
                                    <div class="kds-header-row-2">
                                        <div class="kds-operational-status">
                                            <t t-if="ticket.ticket_type === 'cancellation'">
                                                <span class="kds-op-badge kds-op-badge--cancellation">CANCELACION</span>
                                            </t>
                                            <t t-elif="ticket.ticket_type === 'addition'">
                                                <span class="kds-op-badge kds-op-badge--addition">ADICION</span>
                                            </t>
                                            <t t-elif="ticket.ticket_type === 'modification'">
                                                <span class="kds-op-badge kds-op-badge--modification">MODIFICACION</span>
                                            </t>
                                            <t t-else="">
                                                <span class="kds-op-badge kds-op-badge--new">NUEVO</span>
                                            </t>
                                        </div>
                                        <div class="kds-order-type-inline">
                                            <t t-if="ticket.order_type === 'mesa'">
                                                <span class="kds-type-badge kds-type-mesa">MESA</span>
                                            </t>
                                            <t t-elif="ticket.order_type === 'delivery'">
                                                <span class="kds-type-badge kds-type-delivery">DELIVERY</span>
                                            </t>
                                            <t t-else="">
                                                <span class="kds-type-badge kds-type-pickup">RETIRO</span>
                                            </t>
                                        </div>
                                        <span t-att-class="ticket.payment_status === 'paid' ? 'kds-payment-badge kds-payment--paid' : 'kds-payment-badge kds-payment--unpaid'">
                                            <t t-esc="ticket.payment_status === 'paid' ? 'PAGADO' : 'FALTA PAGAR'"/>
                                        </span>
                                    </div>
                                </div>

                                <!-- Product Lines -->
                                <div class="kds-card-body">
                                    <t t-set="lastCat" t-value="''"/>
                                    <t t-foreach="ticket.lines" t-as="line" t-key="line.id">
                                        <!-- Category Section Header -->
                                        <t t-if="line.category_label !== lastCat">
                                            <t t-set="lastCat" t-value="line.category_label"/>
                                            <div class="kds-category-header">
                                                <span><t t-esc="line.category_label"/></span>
                                            </div>
                                        </t>

                                        <div class="kds-line"
                                             t-att-class="line.state === 'ready' ? 'kds-line kds-line--ready' : line.state === 'cancelled' ? 'kds-line kds-line--cancelled' : line.state === 'waiting' ? 'kds-line kds-line--waiting' : 'kds-line'"
                                             t-on-click.stop="(e) => this.onLineClick(e, line)">

                                            <span class="qty"><t t-esc="line.qty_total"/>x</span>

                                            <span class="product-name"><t t-esc="line.full_product_name"/></span>

                                            <!-- Line Status Badge -->
                                            <span t-att-class="line.state === 'pending' ? 'kds-line-status kds-line-status--pending' : line.state === 'cooking' ? 'kds-line-status kds-line-status--cooking' : line.state === 'waiting' ? 'kds-line-status kds-line-status--waiting' : line.state === 'ready' ? 'kds-line-status kds-line-status--ready' : 'kds-line-status kds-line-status--cancelled'">
                                                <t t-esc="this.getLineStatusLabel(line.state)"/>
                                            </span>

                                            <!-- Cancel Line Button -->
                                            <t t-if="line.state !== 'cancelled'">
                                                <button class="kds-line-btn-cancel"
                                                        t-on-click.stop="(e) => this.cancelLine(e, line)">
                                                    X
                                                </button>
                                            </t>
                                        </div>

                                        <!-- Note Block -->
                                        <t t-if="line.note">
                                            <t t-set="noteClass" t-value="this.getModifierClass(line.note)"/>
                                            <div class="kds-inline-note" t-att-class="'kds-inline-note ' + noteClass">
                                                <t t-esc="line.note"/>
                                            </div>
                                        </t>
                                    </t>

                                    <!-- Next Action Hint -->
                                    <t t-if="ticket.state !== 'delivered' and ticket.state !== 'cancelled'">
                                        <div class="kds-next-action">
                                            <t t-if="ticket.state === 'pending'">TAP — AL HORNO</t>
                                            <t t-elif="ticket.state === 'cooking'">TAP — LISTO</t>
                                            <t t-elif="ticket.state === 'waiting'">TAP — AL HORNO</t>
                                            <t t-elif="ticket.state === 'ready'">TAP — ENTREGADO</t>
                                        </div>
                                    </t>
                                </div>

                                <!-- Footer with Print + Cancel Buttons -->
                                <div class="kds-card-footer">
                                    <button class="kds-btn-print"
                                            t-att-value="ticket.id"
                                            t-on-click.stop="(e) => this.printTicket(e, ticket)">
                                        Imprimir
                                    </button>
                                    <button class="kds-btn-cancel"
                                            t-att-value="ticket.id"
                                            t-on-click.stop="(e) => this.cancelTicket(e)">
                                        Cancelar Ticket
                                    </button>
                                </div>
                            </div>
                        </t>
                    </t>
                </div>

                <!-- ========== UNDO TOAST ========== -->
                <div class="kds-undo-toast"
                     t-att-class="state.undoToast.visible ? 'kds-undo-toast kds-undo-toast--visible' : 'kds-undo-toast'">
                    <span class="kds-undo-toast__message"><t t-esc="state.undoToast.message"/></span>
                    <button class="kds-undo-toast__btn" t-on-click="() => this.undoLastAction()">
                        DESHACER
                    </button>
                    <div class="kds-undo-toast__progress"
                         t-att-style="'width: ' + state.undoToast.progress + '%; transition-duration: ' + state.undoToast.duration + 'ms;'">
                    </div>
                </div>

                <!-- ========== AUDIO ALERT INDICATOR ========== -->
                <div class="kds-audio-alert"
                     t-att-class="state.audioAlertActive ? 'kds-audio-alert kds-audio-alert--active' : 'kds-audio-alert'"
                     t-on-click="() => this.dismissAudioAlert()">
                    <svg class="kds-audio-alert__icon" viewBox="0 0 24 24">
                        <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
                    </svg>
                </div>
            </div>
        </div>
    </t>
</template>
