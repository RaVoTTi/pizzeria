{
  "name": "pizzeria-el-gordo-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright E2E tests for Pizzeria El Gordo POS & Kitchen Display",
  "scripts": {
    "test": "playwright test",
